# =============================================================================
# PerGon OS — root environment reference
# =============================================================================
# Prefer app-level files:
#   apps/web/.env.local
#   apps/admin/.env.local
# Never commit real secrets. Vercel: configure per project (Web ≠ Admin).
# Full matrix: docs/ENVIRONMENT_REFERENCE.md · Deploy: docs/VERCEL_DEPLOY.md
# =============================================================================

# ——— App ———
# Canonical public origin for THIS app (no trailing slash). One value per Vercel project.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ——— Supabase ———
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ——— Storage ———
# Optional overrides; defaults equal the logical bucket names.
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_MEDIA=media
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_EXPORTS=exports
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_AVATARS=avatars
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_DOCUMENTS=documents

# ——— Identity / Setup (Admin) ———
# Long random string. Required to enable first-organization bootstrap.
PERGON_SETUP_SECRET=

# ——— CMS / Preview / Revalidate ———
# Shared secret: Web revalidate route + Admin publish/revalidate caller.
CMS_REVALIDATE_SECRET=
# Optional dedicated preview HMAC secret (falls back to CMS_REVALIDATE_SECRET).
CMS_PREVIEW_SECRET=
# Admin only: public origin of the Web app (preview links + revalidate HTTP calls).
NEXT_PUBLIC_WEB_URL=http://localhost:3000
# Legacy alias for NEXT_PUBLIC_WEB_URL (optional).
# WEB_APP_URL=http://localhost:3000

# ——— PerGon Expert / AI Providers ———
# Preferred provider selector: openai | anthropic | stub
EXPERT_AI_PROVIDER=
EXPERT_OPENAI_API_KEY=
EXPERT_OPENAI_MODEL=
EXPERT_OPENAI_BASE_URL=
EXPERT_ANTHROPIC_API_KEY=
EXPERT_ANTHROPIC_MODEL=
# Optional aliases (code falls back when EXPERT_* unset)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AI_PROVIDER=

# ——— Development ———
# Never set on Vercel Production or Preview. Exposes password-reset tokens in API JSON.
# ALLOW_DEV_RESET_TOKEN=1

# ——— Platform (injected; do not set in .env.local) ———
# NODE_ENV, CI, VERCEL, VERCEL_ENV, VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL, HUSKY
