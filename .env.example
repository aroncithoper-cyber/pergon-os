# PerGon OS — environment reference
# Prefer app-level `.env.local` (apps/web, apps/admin). Never commit secrets.
# Vercel: configure per project (Web vs Admin). See docs/VERCEL_DEPLOY.md.

# ——— App ———
# Production: full public origin, no trailing slash (one value per Vercel project)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ——— Supabase (Dashboard → Project Settings → API) ———
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ——— Admin bootstrap (required to create first organization) ———
# PERGON_SETUP_SECRET=

# ——— Dev-only: return password-reset tokens in API responses ———
# Never set on Vercel Production or Preview.
# ALLOW_DEV_RESET_TOKEN=1

# ——— Storage bucket names (optional overrides; defaults = logical names) ———
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_MEDIA=media
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_EXPORTS=exports
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_AVATARS=avatars
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_DOCUMENTS=documents

# ——— PerGon Expert (multi-provider; never depend on a single vendor) ———
# EXPERT_AI_PROVIDER=openai|anthropic|stub
EXPERT_AI_PROVIDER=
EXPERT_OPENAI_API_KEY=
EXPERT_OPENAI_MODEL=
EXPERT_OPENAI_BASE_URL=
EXPERT_ANTHROPIC_API_KEY=
EXPERT_ANTHROPIC_MODEL=
