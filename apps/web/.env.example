# PerGon OS — Web (.env.local)
# Copy this file to apps/web/.env.local and fill keys from Supabase Dashboard.
# On Vercel: set the same keys in Project → Settings → Environment Variables
# (Production + Preview). NEXT_PUBLIC_* must be present at build time.

# Production: https://your-web-domain (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage buckets (optional)
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_MEDIA=media
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_EXPORTS=exports
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_AVATARS=avatars
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_DOCUMENTS=documents

# Expert (optional)
EXPERT_AI_PROVIDER=
EXPERT_OPENAI_API_KEY=
EXPERT_OPENAI_MODEL=
EXPERT_OPENAI_BASE_URL=
EXPERT_ANTHROPIC_API_KEY=
EXPERT_ANTHROPIC_MODEL=

# Never enable in Production / Preview on Vercel
# ALLOW_DEV_RESET_TOKEN=1
