# =============================================================================
# PerGon OS — Admin (.env.example → copy to apps/admin/.env.local)
# =============================================================================
# Vercel (Admin project): set the same keys for Production + Preview.
# NEXT_PUBLIC_* must be present at build time.
# Reference: docs/ENVIRONMENT_REFERENCE.md
# =============================================================================

# ——— App ———
# Production: https://your-admin-domain (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ——— Supabase ———
# Dashboard → Project Settings → API (same project as Web if shared data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ——— Storage ———
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_MEDIA=media
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_EXPORTS=exports
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_AVATARS=avatars
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_DOCUMENTS=documents

# ——— Identity / Setup ———
# Long random secret. Required for first-organization bootstrap.
# If the value contains #, wrap it in double quotes (otherwise .env truncates at #).
PERGON_SETUP_SECRET=

# ——— CMS / Preview / Revalidate ———
# Public origin of the Web app (no trailing slash).
NEXT_PUBLIC_WEB_URL=http://localhost:3000
# Legacy alias for NEXT_PUBLIC_WEB_URL (optional).
# WEB_APP_URL=http://localhost:3000
# Must match Web CMS_REVALIDATE_SECRET.
CMS_REVALIDATE_SECRET=
# Optional; falls back to CMS_REVALIDATE_SECRET (then local-dev default).
CMS_PREVIEW_SECRET=

# ——— PerGon Expert / AI Providers (optional; Admin knowledge tools) ———
EXPERT_AI_PROVIDER=
EXPERT_OPENAI_API_KEY=
EXPERT_OPENAI_MODEL=
EXPERT_OPENAI_BASE_URL=
EXPERT_ANTHROPIC_API_KEY=
EXPERT_ANTHROPIC_MODEL=
# Optional aliases
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AI_PROVIDER=

# ——— Development ———
# Never enable on Vercel Production / Preview.
# ALLOW_DEV_RESET_TOKEN=1
