{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "CI",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL",
    "VERCEL_PROJECT_PRODUCTION_URL",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_MEDIA",
    "NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_EXPORTS",
    "NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_AVATARS",
    "NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_DOCUMENTS",
    "EXPERT_AI_PROVIDER",
    "EXPERT_OPENAI_API_KEY",
    "EXPERT_OPENAI_MODEL",
    "EXPERT_OPENAI_BASE_URL",
    "EXPERT_ANTHROPIC_API_KEY",
    "EXPERT_ANTHROPIC_MODEL",
    "OPENAI_API_KEY",
    "ANTHROPIC_API_KEY",
    "AI_PROVIDER",
    "PERGON_SETUP_SECRET",
    "ALLOW_DEV_RESET_TOKEN",
    "HUSKY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
